    <RootNamespace>MP4_to_Gif_Converter</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore.Extensions.Downloader" Version="5.0.0" />
  </ItemGroup>

</Project>